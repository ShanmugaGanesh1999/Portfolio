{
  "name": "portfolio",
  "compatibility_date": "2026-02-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "main": "worker/index.js",
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "19990915",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "build": {
    "command": "node scripts/build-worker-context.mjs"
  }
}
